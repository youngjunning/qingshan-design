{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Qingshan Design",
  "version": "1.0.0",
  "disclaimer": "Independent design language inspired by Qingshan Lake in Lin'an, Hangzhou; not an official scenic-area design system.",
  "color": {
    "canvas": "#F4F6F1",
    "surface": "#FBFCFA",
    "surfaceMuted": "#E8EEEA",
    "mistWhite": "#F2F7F2",
    "cloudBelt": "#B8CCDB",
    "blueMist": "#8AADD1",
    "lakeMist": "#85C7BA",
    "lakeTeal": "#2E948A",
    "lakeTealStrong": "#286B66",
    "primaryContainer": "#DCEFEB",
    "deepLakeInk": "#183B40",
    "secondaryInk": "#4D676B",
    "cypress": "#4F8751",
    "cypressStrong": "#356439",
    "duckweed": "#6D9C52",
    "dawnGold": "#D6A352",
    "dawnStrong": "#7A5B1E",
    "clay": "#A95B4B",
    "clayStrong": "#8E493E",
    "border": "#D4DFDC",
    "darkCanvas": "#0F2B36",
    "darkSurface": "#183B40",
    "darkSurfaceElevated": "#234B50",
    "white": "#FFFFFF"
  },
  "semantic": {
    "background": "{color.canvas}",
    "surface": "{color.surface}",
    "surfaceMuted": "{color.surfaceMuted}",
    "text": "{color.deepLakeInk}",
    "textSecondary": "{color.secondaryInk}",
    "primary": "{color.lakeTeal}",
    "primaryAction": "{color.lakeTealStrong}",
    "onPrimaryAction": "{color.white}",
    "primaryContainer": "{color.primaryContainer}",
    "onPrimaryContainer": "{color.deepLakeInk}",
    "success": "{color.cypressStrong}",
    "warning": "{color.dawnStrong}",
    "error": "{color.clayStrong}",
    "border": "{color.border}",
    "focus": "{color.lakeTealStrong}",
    "darkBackground": "{color.darkCanvas}",
    "darkSurface": "{color.darkSurface}",
    "onDark": "{color.mistWhite}",
    "onDarkSecondary": "{color.cloudBelt}"
  },
  "contrastPairs": [
    { "foreground": "semantic.text", "background": "semantic.background", "minimum": 4.5 },
    { "foreground": "semantic.textSecondary", "background": "semantic.background", "minimum": 4.5 },
    { "foreground": "semantic.onPrimaryAction", "background": "semantic.primaryAction", "minimum": 4.5 },
    { "foreground": "semantic.onPrimaryContainer", "background": "semantic.primaryContainer", "minimum": 4.5 },
    { "foreground": "semantic.success", "background": "semantic.surface", "minimum": 4.5 },
    { "foreground": "semantic.warning", "background": "semantic.surface", "minimum": 4.5 },
    { "foreground": "semantic.error", "background": "semantic.surface", "minimum": 4.5 },
    { "foreground": "semantic.onDark", "background": "semantic.darkBackground", "minimum": 4.5 },
    { "foreground": "semantic.onDarkSecondary", "background": "semantic.darkBackground", "minimum": 4.5 }
  ]
}
